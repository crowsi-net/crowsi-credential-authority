{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "crowsi://credential-authority/host-config/v4",
  "title": "Crowsi credential authority host config v4",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema", "deployment_role",
    "authority_store_directory", "authority_anchor_directory",
    "operation_state_directory", "management_state_directory",
    "management_anchor_directory", "response_signing_key_path",
    "response_key_id", "response_public_key_hex", "identity_issuer",
    "registration_audience", "management_audience", "management_projection_issuer",
    "management_projection_signing_key_path", "management_projection_key_id",
    "management_projection_public_key_hex",
    "revocation_execution_reservation_signing_key_path",
    "revocation_execution_reservation_key_id",
    "revocation_execution_reservation_public_key_hex",
    "revocation_execution_reservation_config_generation",
    "identity_key_id", "identity_public_key_hex",
    "current_status_key_id", "current_status_public_key_hex", "user_verification_key_id",
    "user_verification_public_key_hex", "identity_response_key_id",
    "identity_response_public_key_hex", "minimum_identity_config_generation",
    "identity_finalization_authority_id", "revocation_approval_authority_refs",
    "provider_operations", "owner_mappings", "device_proof_keys", "authority_epoch",
    "issued_at_epoch_s", "expires_at_epoch_s", "configuration_key_id", "signature"
  ],
  "properties": {
    "schema": { "const": "crowsi://credential-authority/host-config/v4" },
    "deployment_role": { "const": "single-central-authority-host" },
    "authority_store_directory": { "$ref": "#/$defs/path" },
    "authority_anchor_directory": { "$ref": "#/$defs/path" },
    "operation_state_directory": { "$ref": "#/$defs/path" },
    "management_state_directory": { "$ref": "#/$defs/path" },
    "management_anchor_directory": { "$ref": "#/$defs/path" },
    "response_signing_key_path": { "$ref": "#/$defs/path" },
    "response_key_id": { "$ref": "#/$defs/id" },
    "response_public_key_hex": { "$ref": "#/$defs/key" },
    "identity_issuer": { "type": "string", "minLength": 1, "maxLength": 512 },
    "registration_audience": { "$ref": "#/$defs/id" },
    "management_audience": { "$ref": "#/$defs/id" },
    "management_projection_issuer": { "type": "string", "minLength": 1, "maxLength": 256 },
    "management_projection_signing_key_path": { "$ref": "#/$defs/path" },
    "management_projection_key_id": { "$ref": "#/$defs/id" },
    "management_projection_public_key_hex": { "$ref": "#/$defs/key" },
    "revocation_execution_reservation_signing_key_path": { "$ref": "#/$defs/path" },
    "revocation_execution_reservation_key_id": { "$ref": "#/$defs/id" },
    "revocation_execution_reservation_public_key_hex": { "$ref": "#/$defs/key" },
    "revocation_execution_reservation_config_generation": { "type": "integer", "minimum": 1 },
    "identity_key_id": { "$ref": "#/$defs/id" },
    "identity_public_key_hex": { "$ref": "#/$defs/key" },
    "current_status_key_id": { "$ref": "#/$defs/id" },
    "current_status_public_key_hex": { "$ref": "#/$defs/key" },
    "user_verification_key_id": { "$ref": "#/$defs/id" },
    "user_verification_public_key_hex": { "$ref": "#/$defs/key" },
    "identity_response_key_id": { "$ref": "#/$defs/id" },
    "identity_response_public_key_hex": { "$ref": "#/$defs/key" },
    "minimum_identity_config_generation": { "type": "integer", "minimum": 1 },
    "identity_finalization_authority_id": { "$ref": "#/$defs/id" },
    "revocation_approval_authority_refs": {
      "type": "array", "minItems": 1, "maxItems": 16, "uniqueItems": true,
      "items": { "$ref": "#/$defs/id" }
    },
    "provider_operations": {
      "type": "array", "minItems": 1, "maxItems": 64,
      "items": { "$ref": "#/$defs/provider" }
    },
    "owner_mappings": { "type": "array", "minItems": 1, "maxItems": 10000 },
    "device_proof_keys": { "type": "array", "minItems": 1, "maxItems": 10000 },
    "authority_epoch": { "type": "integer", "minimum": 1 },
    "issued_at_epoch_s": { "type": "integer", "minimum": 1 },
    "expires_at_epoch_s": { "type": "integer", "minimum": 1 },
    "configuration_key_id": { "$ref": "#/$defs/id" },
    "signature": { "type": "string", "minLength": 1, "maxLength": 1024 }
  },
  "$defs": {
    "id": { "type": "string", "minLength": 1, "maxLength": 128 },
    "path": { "type": "string", "pattern": "^/", "maxLength": 4096 },
    "digest": { "type": "string", "pattern": "^sha256:[0-9a-f]{64}$" },
    "key": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
    "provider": {
      "type": "object", "additionalProperties": false,
      "required": ["service_id", "executable", "executable_sha256", "config_path",
        "config_sha256", "state_directory", "response_key_id", "response_public_key_hex"],
      "properties": {
        "service_id": { "$ref": "#/$defs/id" },
        "executable": { "$ref": "#/$defs/path" },
        "executable_sha256": { "$ref": "#/$defs/digest" },
        "config_path": { "$ref": "#/$defs/path" },
        "config_sha256": { "$ref": "#/$defs/digest" },
        "state_directory": { "$ref": "#/$defs/path" },
        "response_key_id": { "$ref": "#/$defs/id" },
        "response_public_key_hex": { "$ref": "#/$defs/key" }
      }
    }
  }
}
